# /etc/nginx/sites-available/boxtech-dashboard
# Demo build: keep it behind basic auth until real data is loaded.
#   sudo apt install apache2-utils
#   sudo htpasswd -c /etc/nginx/.htpasswd boxtech

server {
    listen 80;
    server_name reports.boxtech.ai;   # <-- change to your domain

    # Certbot writes its challenge here; leave this above the auth block.
    location /.well-known/acme-challenge/ { root /var/www/html; auth_basic off; }

    location / {
        auth_basic           "BoxTech Reporting (demo)";
        auth_basic_user_file /etc/nginx/.htpasswd;

        proxy_pass         http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        'upgrade';
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 60s;
    }

    # Next.js fingerprints these filenames, so they're safe to cache hard.
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3100;
        add_header Cache-Control "public, max-age=31536000, immutable";
        auth_basic off;
    }
}
